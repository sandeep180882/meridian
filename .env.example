# ── Azure Event Hub ──────────────────────────────────────────
EVENTHUB_CONNECTION_STRING=Endpoint=sb://<ns>.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=<key>
EVENTHUB_NAME=customer-events
EVENTHUB_CONSUMER_GROUP=$Default

# ── PostgreSQL (runs as a container — no Azure needed) ────────
POSTGRES_HOST=postgres          # Docker service name — do not change
POSTGRES_PORT=5432
POSTGRES_DB=eventpoc
POSTGRES_USER=eventpoc
POSTGRES_PASSWORD=changeme      # change this

# ── Azure OpenAI ─────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_KEY=<key>
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-01

# ── Twilio ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=<token>
TWILIO_FROM_WHATSAPP=whatsapp:+14155238886
TWILIO_FROM_SMS=+1XXXXXXXXXX
TWILIO_TWIML_BIN_URL=https://handler.twilio.com/twiml/<bin-id>

# ── Agent URLs (Docker internal DNS — do not change) ─────────
BILLING_AGENT_URL=http://billing-agent:8001
ACCOUNT_AGENT_URL=http://account-agent:8002
NOTIFICATION_AGENT_URL=http://notification-agent:8003

DEBUG=true
